INPUTQUANTITY_CHECKNUM:
    MOV CL, [SI+1]
    MOV CH, 0
    ADD SI, 2

    CALL CHECK_IS_BACK
    CMP AL, 1
    JE INPUTQUANTITY_BACK

    CALL VALID_NUMERIC
    CMP AL, 0
    JE INPUTQUANTITY_CHECKRANGE

    MOV AH, 09H
    LEA DX, msgInvalidNumeric
    INT 21H
    MOV AL, 1
    JMP INPUTQUANTITY_DONE
INPUTQUANTITY_CHECKRANGE:
    MOV BX, DX
    MOV CL, [BX+1]
    MOV CH, 0
    MOV SI, BX
    ADD SI, 2
    CALL STR_TO_NUM

    MOV BX, 1
    MOV CX, 10
    CALL CHECK_RANGE
    
    CMP AL, 0
    JE INPUTQUANTITY_VALID

    MOV AH, 09H
    LEA DX, msgInvalidQuantity
    INT 21H
    MOV AL, 1
    JMP INPUTQUANTITY_DONE
INPUTQUANTITY_BACK:
    MOV AL, 2
    JMP INPUTQUANTITY_DONE
INPUTQUANTITY_VALID:
    MOV AL, 0
INPUTQUANTITY_DONE:
    POP CX
    POP SI
    RET
INPUT_QUANTITY ENDP

