.CODE               ; BEGINNING OF CODE SEGMENT
MAIN PROC

    MOV AX, @DATA
    MOV DS, AX

    MOV AH, 09H
    LEA DX, msgTitle
    INT 21H

    CMP loginStatus, 0
    JE MAIN_LOOP

ASK_LOGIN:
    MOV backToMenu, 0
    MOV AH, 09H
    LEA DX, msgAskLogin
    INT 21H

    MOV AH, 01H
    INT 21H
    CMP AL, 'L'
    JE LOGIN_
    CMP AL, 'R'
    JE REGISTER_

    MOV AH, 09H
    LEA DX, msgInvalidAskLogin
    INT 21H
    JMP ASK_LOGIN

REGISTER_:
    CALL REGISTER
    CMP backToMenu, 1
    JE ASK_LOGIN

LOGIN_:
    CALL LOGIN
    CMP backToMenu, 1
    JE ASK_LOGIN

    CMP loginStatus, 1
    JE MAIN_END             ;LOCKED OUT & EXIT

MAIN_LOOP:
    CALL DATA_ENTRY

    LEA DX, msgLogoutPrompt
    CALL CONFIRM_ACTION
    CMP AL, 'N'
    JE MAIN_LOOP

    CALL LOGOUT

MAIN_END:
MOV AH, 4CH         ; Terminate program and return control to DOS
INT 21H
MAIN ENDP

;MODULE 1: LOGIN & LOGOUT

REGISTER PROC

    MOV AH, 09H
    LEA DX, msgRegister
    INT 21H

R_USERNAME_RETRY:
    MOV AH, 09H
    LEA DX, msgRegisterUser
    INT 21H

    LEA DX, registerUsername
    CALL INPUT_USERNAME
    CMP AL, 1
    JE R_USERNAME_RETRY
    CMP AL, 2
    JE R_USERNAME_FIRST

R_PASSWORD_RETRY:
    MOV AH, 09H
    LEA DX, msgRegisterPassword
    INT 21H

    LEA DX, registerPassword
    CALL INPUT_PASSWORD
    CMP AL, 1
    JE R_PASSWORD_RETRY
    CMP AL, 2
    JE R_USERNAME_RETRY

    ; Registration successful
    MOV AH, 09H
    LEA DX, msgRegisterSuccess
    INT 21H

    RET

R_USERNAME_FIRST:
    MOV AH, 09H
    LEA DX, msgReturnToMenu
    INT 21H
    MOV backToMenu, 1
    RET

REGISTER ENDP


LOGIN PROC

    MOV AH, 09H
    LEA DX, msgTitle
    INT 21H

    MOV AH, 09H
    LEA DX, msglogin
    INT 21H

LOGIN_USER_RETRY:
    ; Ask username
    MOV AH, 09H
    LEA DX, msgLoginUsername
    INT 21H

    LEA DX, loginUsername
    CALL INPUT_USERNAME
    CMP AL, 1
    JE LOGIN_USER_RETRY
    CMP AL, 2
    JE LOGIN_USER_FIRST

LOGIN_PASS_RETRY:
    ; Ask password
    MOV AH, 09H
    LEA DX, msgLoginPassword
    INT 21H

    LEA DX, loginPassword
    CALL INPUT_PASSWORD
    CMP AL, 1
    JE LOGIN_PASS_RETRY
    CMP AL, 2
    JE LOGIN_USER_RETRY

    ; Compare username
    LEA SI, loginUsername
    LEA DI, registerUsername
    CALL COMPARE_STRING
    CMP AL, 0
    JNE LOGIN_USERNAME_MISMATCH

    ; Compare password
    LEA SI, loginPassword
    LEA DI, registerPassword
    CALL COMPARE_STRING
    CMP AL, 0
    JNE LOGIN_PASSWORD_MISMATCH

    ; Login successful
    MOV AH, 09H
    LEA DX, msgLoginSuccess
    INT 21H

    MOV loginStatus, 0
    RET

LOGIN_USER_FIRST:
    MOV AH, 09H
    LEA DX, msgReturnToMenu
    INT 21H
    MOV backToMenu, 1
    RET

LOGIN_USERNAME_MISMATCH:
    MOV AH, 09H
    LEA DX, msgUsernameNotMatch
    INT 21H
    JMP LOGIN_FAILED

LOGIN_PASSWORD_MISMATCH:
    MOV AH, 09H
    LEA DX, msgPasswordNotMatch
    INT 21H

LOGIN_FAILED:
    DEC attempts
    CMP attempts, 0
    JE LOGIN_LOCKED

    MOV AH, 09H
    LEA DX, msgAttempts
    INT 21H

    ; Convert number to ASCII
    MOV DL, attempts
    ADD DL, '0'
    MOV AH, 02H
    INT 21H

    JMP LOGIN_USER_RETRY


LOGIN_LOCKED:

    MOV AH, 09H
    LEA DX, msgLocked
    INT 21H

    MOV loginStatus, 1
    RET

LOGIN ENDP

LOGOUT PROC
    MOV AH, 09H
    LEA DX, msgLogout
    INT 21H

    RET
LOGOUT ENDP


