; COMPARE STRING

COMPARE_STRING PROC
    PUSH CX
    PUSH SI
    PUSH DI

    MOV AL, [SI+1]
    MOV AH, [DI+1]
    CMP AL, AH
    JNE NOT_EQUAL

    MOV CL, AL
    MOV CH, 0
    CMP CL, 0
    JE EQUAL

    ADD SI, 2
    ADD DI, 2

COMPARE_LOOP:
    
    MOV AL, [SI]
    MOV AH, [DI]
    CMP AL, AH
    JNE NOT_EQUAL

    INC SI
    INC DI
    LOOP COMPARE_LOOP

EQUAL:
    MOV AL, 0
    JMP COMPARE_DONE

NOT_EQUAL:
    MOV AL, 1

COMPARE_DONE:
    POP DI
    POP SI
    POP CX
    RET
COMPARE_STRING ENDP


;MODULE 7: INPUT VALIDATION
CHECK_IS_BACK PROC
    CMP CX, 1
    JNE CIB_NO
    MOV AL, [SI]
    CMP AL, 'B'
    JE CIB_YES
    CMP AL, 'b'
    JE CIB_YES
CIB_NO:
    MOV AL, 0
    RET
CIB_YES:
    MOV AL, 1
    RET
CHECK_IS_BACK ENDP


VALID_LETTER_NUM PROC
    PUSH SI

VALIDLN_NUM:
    MOV AL, [SI]
    CMP AL, '0'
    JB VALIDLN_CHECKALPHA
    CMP AL, '9'
    JBE VALIDLN_NEXT

VALIDLN_CHECKALPHA:
    CMP AL, 'A'
    JB VALIDLN_INVALID
    CMP AL, 'Z'
    JBE VALIDLN_NEXT
    CMP AL, 'a'
    JB VALIDLN_INVALID
    CMP AL, 'z'
    JA VALIDLN_INVALID

VALIDLN_NEXT:
    INC SI
    LOOP VALIDLN_NUM
    JMP VALIDLN_DONE

VALIDLN_INVALID:
    POP SI
    MOV AL, 1
    RET

VALIDLN_DONE:
    POP SI
    MOV AL, 0
    RET
VALID_LETTER_NUM ENDP

VALID_PASSWORD PROC
    PUSH SI
VALIDP_LOOP:
    MOV AL, [SI]
    CMP AL, '!'
    JB VALIDP_INVALID
    CMP AL, '~'
