; STR_TO_NUM - convert a run of ASCII digits into a 16-bit number
; IN: SI = ptr to first digit, CL = digit count   OUT: AX = value
STR_TO_NUM PROC
    PUSH BX
    PUSH CX
    PUSH DX
    PUSH SI
    MOV AX, 0
STN_LOOP:
    MOV BL, [SI]
    SUB BL, '0'
    MOV BH, 0
    MOV DX, 10
    MUL DX              ; AX = AX * 10
    ADD AX, BX
    INC SI
    LOOP STN_LOOP
    POP SI
    POP DX
    POP CX
    POP BX
    RET
STR_TO_NUM ENDP

CHECK_RANGE PROC
; Check if number is in range [min, max]
    CMP AX, BX          ; Compare with min
    JB CHECK_RANGE_FAIL
    CMP AX, CX          ; Compare with max
    JA CHECK_RANGE_FAIL
    JMP CHECK_RANGE_DONE

CHECK_RANGE_FAIL:
    ; Number is not in range
    MOV AL, 1
    RET

CHECK_RANGE_DONE:
   ; Number is in range
    MOV AL, 0
    RET
CHECK_RANGE ENDP

