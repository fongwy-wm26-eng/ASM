; Display header
    MOV AH, 09H
    LEA DX, msgLayoutHeader
    INT 21H
    MOV AH, 09H
    LEA DX, msgAvailable
    INT 21H

;print layout
    LEA SI, seat_map
    MOV CX, 5

ROW_LOOP:
    PUSH CX
    MOV CX,10

SEAT_LOOP:
    MOV AL, [SI]
    CMP AL, '0'
    JE SEAT_OPEN 

SEAT_TAKEN:
    MOV AH, 02H
    MOV DL, '['
    INT 21H
    MOV DL, 'X'
    INT 21H
    MOV DL, ']'
    INT 21H
    JMP NEXT_SEAT

SEAT_OPEN:
    MOV AH, 02H
    MOV DL, '['
    INT 21H
    MOV DL, 'O'
    INT 21H
    MOV DL, ']'
    INT 21H

NEXT_SEAT:
    MOV AH, 02H
    MOV DL, ' '
    INT 21H

    INC SI
    LOOP SEAT_LOOP
;Next row
    MOV AH, 09H
    LEA DX, newline
    INT 21H

    POP CX
    LOOP ROW_LOOP

    POP SI
    POP DX
    POP CX
    POP BX
    POP AX

    RET
VIEW_SEAT_LAYOUT ENDP

