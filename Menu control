CLEAR_LOOP:
    CMP BX, 50              
    JAE CANCEL_SUCCESS

    MOV BYTE PTR [SI], '0'  
    INC SI                  
    INC BX                  
    LOOP CLEAR_LOOP

CANCEL_SUCCESS:
    MOV AH, 09H
    LEA DX, msgCancelSuccess
    INT 21H

CANCEL_DONE:
    POP SI
    POP DX
    POP CX
    POP BX
    POP AX
    RET                     
CANCEL_RESERVATION ENDP

CALCULATE_PAYMENT PROC
    PUSH AX
    PUSH BX
    PUSH CX
    PUSH DX
    PUSH SI
;check if data exists
    LEA SI, quantity
    MOV CL, [SI+1]         
    MOV CH, 0
    CMP CL, 0
    JNE CALC_START

;no data message
    MOV AH, 09H
    LEA DX, msgNoData       
    INT 21H
    JMP CALC_DONE

CALC_START:
;convert quantity string to number
    ADD SI, 2
    CALL STR_TO_NUM        
    MOV valQuantity, AX

;link ticket type to price
    LEA BX, ticketType
    MOV AL, [BX+2]          

    CMP AL, '1'           
    JE SET_PRICE_ADULT
    CMP AL, '2'            
    JE SET_PRICE_CHILD


    MOV AX, seniorTicket    
    MOV basePrice, AX       
    JMP CALC_SUBTOTAL

SET_PRICE_ADULT:
    MOV AX, adultTicket     
    MOV basePrice, AX
    JMP CALC_SUBTOTAL

SET_PRICE_CHILD:
    MOV AX, childTicket    
    MOV basePrice, AX

CALC_SUBTOTAL:
;subtotal = basePrice * quantity
    MOV AX, basePrice
    MUL valQuantity              
    MOV basePrice, AX       

;discount (if more than 5 tickets, 5% discount)
    CMP valQuantity, 5
    JAE APPLY_DISCOUNT
    MOV discount, 0        
    JMP CALC_TOTAL

APPLY_DISCOUNT:
    MOV discount, 5

CALC_TOTAL:
;total = subtotal - discount + serviceTax
    MOV AX, basePrice
    SUB AX, discount
    ADD AX, serviceTax     
    MOV totalPayment, AX

;receipt output
    MOV AH, 09H
    LEA DX, msgCalcTitle   
    INT 21H

;display subtotal
    LEA DX, msgCalcSubtotal 
    INT 21H
    MOV AX, basePrice
    CALL PRINT_NUM
    MOV AH, 09H
    LEA DX, newline        
    INT 21H

;display discount
    LEA DX, msgCalcDiscount 
    INT 21H
    MOV AX, discount
    CALL PRINT_NUM
    MOV AH, 09H
    LEA DX, newline
    INT 21H

;display service tax
    LEA DX, msgCalcTax     
    INT 21H
    MOV AX, serviceTax
    CALL PRINT_NUM
    MOV AH, 09H
    LEA DX, newline
    INT 21H

;display line and total payment
    LEA DX, msgCalcLine    
    INT 21H
    LEA DX, msgCalcTotal   
    INT 21H
    MOV AX, totalPayment
    CALL PRINT_NUM
    MOV AH, 09H
    LEA DX, newline
    INT 21H

CALC_DONE:
    POP SI
    POP DX
    POP CX
    POP BX
    POP AX
    RET
CALCULATE_PAYMENT ENDP
    

