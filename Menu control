;MODULE 1: LOGIN & LOGOUT

REGISTER PROC

    MOV AH, 09H
    LEA DX, msgRegister
    INT 21H

R_USERNAME_RETRY:
    MOV AH, 09H
    LEA DX, msgRegisterUser
    INT 21H

    LEA DX, registerUsername
    CALL INPUT_USERNAME
    CMP AL, 1
    JE R_USERNAME_RETRY
    CMP AL, 2
    JE R_USERNAME_FIRST

R_PASSWORD_RETRY:
    MOV AH, 09H
    LEA DX, msgRegisterPassword
    INT 21H

    LEA DX, registerPassword
    CALL INPUT_PASSWORD
    CMP AL, 1
    JE R_PASSWORD_RETRY
    CMP AL, 2
    JE R_USERNAME_RETRY

    ; Registration successful
    MOV AH, 09H
    LEA DX, msgRegisterSuccess
    INT 21H

    RET

R_USERNAME_FIRST:
    MOV AH, 09H
    LEA DX, msgReturnToMenu
    INT 21H
    MOV backToMenu, 1
    RET

REGISTER ENDP


LOGIN PROC

    MOV AH, 09H
    LEA DX, msgTitle
    INT 21H

    MOV AH, 09H
    LEA DX, msglogin
    INT 21H

LOGIN_USER_RETRY:
    ; Ask username
    MOV AH, 09H
    LEA DX, msgLoginUsername
    INT 21H

    LEA DX, loginUsername
    CALL INPUT_USERNAME
    CMP AL, 1
    JE LOGIN_USER_RETRY
    CMP AL, 2
    JE LOGIN_USER_FIRST

LOGIN_PASS_RETRY:
    ; Ask password
    MOV AH, 09H
    LEA DX, msgLoginPassword
    INT 21H

    LEA DX, loginPassword
    CALL INPUT_PASSWORD
    CMP AL, 1
    JE LOGIN_PASS_RETRY
    CMP AL, 2
    JE LOGIN_USER_RETRY

    ; Compare username
    LEA SI, loginUsername
    LEA DI, registerUsername
    CALL COMPARE_STRING
    CMP AL, 0
    JNE LOGIN_USERNAME_MISMATCH

    ; Compare password
    LEA SI, loginPassword
    LEA DI, registerPassword
    CALL COMPARE_STRING
    CMP AL, 0
    JNE LOGIN_PASSWORD_MISMATCH

    ; Login successful
    MOV AH, 09H
    LEA DX, msgLoginSuccess
    INT 21H

    MOV loginStatus, 0
    RET

LOGIN_USER_FIRST:
    MOV AH, 09H
    LEA DX, msgReturnToMenu
    INT 21H
    MOV backToMenu, 1
    RET

LOGIN_USERNAME_MISMATCH:
    MOV AH, 09H
    LEA DX, msgUsernameNotMatch
    INT 21H
    JMP LOGIN_FAILED

LOGIN_PASSWORD_MISMATCH:
    MOV AH, 09H
    LEA DX, msgPasswordNotMatch
    INT 21H

LOGIN_FAILED:
    DEC attempts
    CMP attempts, 0
    JE LOGIN_LOCKED

    MOV AH, 09H
    LEA DX, msgAttempts
    INT 21H

    ; Convert number to ASCII
    MOV DL, attempts
    ADD DL, '0'
    MOV AH, 02H
    INT 21H

    JMP LOGIN_USER_RETRY


LOGIN_LOCKED:

    MOV AH, 09H
    LEA DX, msgLocked
    INT 21H

    MOV loginStatus, 1
    RET

LOGIN ENDP

LOGOUT PROC
    MOV AH, 09H
    LEA DX, msgLogout
    INT 21H

    RET
LOGOUT ENDP


; INPUT USERNAME
INPUT_USERNAME PROC
    PUSH SI
    PUSH CX

    MOV AH, 0CH
    MOV AL, 0AH
    INT 21H

    MOV SI, DX
    CMP BYTE PTR [SI+1], 0
    JNE INPUTUSER_CHECKCHARS

    MOV AH, 09H
    LEA DX, msgBlank
    INT 21H
    MOV AL, 1
    JMP INPUTUSER_DONE

INPUTUSER_CHECKCHARS:
    MOV CL, [SI+1]
    MOV CH, 0
    ADD SI, 2

    CALL CHECK_IS_BACK
    CMP AL, 1
    JE INPUTUSER_BACK

    CALL VALID_LETTER_NUM
    CMP AL, 0
    JE INPUTUSER_VALID

    MOV AH, 09H
    LEA DX, msgInvalidUsername
    INT 21H
    MOV AL, 1
    JMP INPUTUSER_DONE

INPUTUSER_BACK:
    MOV AL, 2
    JMP INPUTUSER_DONE

INPUTUSER_VALID:
    MOV AL, 0

INPUTUSER_DONE:
    POP CX
    POP SI
    RET
INPUT_USERNAME ENDP

; INPUT PASSWORD
INPUT_PASSWORD PROC
    PUSH SI
    PUSH CX

    MOV AH, 0CH
    MOV AL, 0AH
    INT 21H

    MOV SI, DX
    CMP BYTE PTR [SI+1], 0
    JNE INPUTPASS_CHECKCHARS

