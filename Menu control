UPDATE_SEAT_MAP PROC
    PUSH AX
    PUSH BX
    PUSH CX
    PUSH DX
    PUSH SI

;convert seat number to index and reserve seats
    LEA SI, seatNumber
    MOV CL, [SI+1]          
    MOV CH, 0
    CMP CL, 0
    JE UPDATE_DONE          

    ADD SI, 2               
    CALL STR_TO_NUM         
    DEC AX                  
    MOV BX, AX              

;convert quantity to loop counter and reserve seats
    LEA SI, quantity
    MOV CL, [SI+1]          
    MOV CH, 0
    CMP CL, 0
    JE UPDATE_DONE          

    ADD SI, 2               
    CALL STR_TO_NUM         
    MOV CX, AX              

    LEA SI, seat_map
    ADD SI, BX              

RESERVE_LOOP:
    ; safety check
    CMP BX, 50
    JAE UPDATE_DONE

    MOV BYTE PTR [SI], '1'  
    INC SI                  
    INC BX                  
    LOOP RESERVE_LOOP       

UPDATE_DONE:
    POP SI
    POP DX
    POP CX
    POP BX
    POP AX
    RET
UPDATE_SEAT_MAP ENDP

